#!/usr/bin/env python3
"""Segredos do control plane no OpenBao (ADR 062), a partir de openbao/secrets.toml (estado desejado).

  cp-secrets status                 selo, versão, mounts de auditoria
  cp-secrets init                   1x: inicializa, abre, liga audit/kv/approle, cria o operador e revoga o root
  cp-secrets unseal                 abre o cofre depois de reiniciar (chaves do .init.json ou digitadas)
  cp-secrets plan | apply           policies + AppRoles de runtime + import de .env (idempotente)
  cp-secrets run <identidade> -- <cmd>   injeta os segredos do ambiente no processo (sem .env em disco)
  cp-secrets audit [horas]          quem leu/alterou o quê (audit log do OpenBao)
  cp-secrets backup                 snapshot do raft (cifrado) em openbao/backups/ — copiar para fora da máquina

Nunca imprime valores de segredo: só nomes, contagens e ids.
"""
import getpass
import json
import os
import stat
import subprocess
import sys
import tomllib
import urllib.error
import urllib.request
from collections import Counter
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BAO = ROOT / "openbao"
CONFIG = BAO / "secrets.toml"
INIT_FILE = BAO / ".init.json"
BOOTSTRAP = BAO / ".bootstrap.env"
RUNTIME_DIR = BAO / "runtime"
ADDR = os.environ.get("CP_BAO_ADDR", "http://127.0.0.1:8200")
OPERATOR = "control-plane-bootstrap"


def die(msg):
    print(f"erro: {msg}", file=sys.stderr)
    sys.exit(1)


def read_env_file(path):
    """KEY=VALUE simples (aspas removidas, comentários ignorados). Valores nunca são impressos."""
    out = {}
    for raw in Path(path).read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, val = line.split("=", 1)
        key = key.removeprefix("export ").strip()
        val = val.strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in "'\"":
            val = val[1:-1]
        out[key] = val
    return out


def write_private(path, content):
    path.parent.mkdir(mode=0o700, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(content)


def check_private(path):
    mode = stat.S_IMODE(path.stat().st_mode)
    if mode & 0o077:
        die(f"{path} precisa ser 600 (está {oct(mode)}): chmod 600 {path}")


def call(method, path, body=None, token=None, ok404=False):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(f"{ADDR}/v1/{path}", data=data, method=method)
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("X-Vault-Token", token)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        if ok404 and e.code == 404:
            return None
        detail = e.read().decode(errors="replace")[:300]
        die(f"{method} {path} → {e.code}: {detail}")
    except urllib.error.URLError as e:
        die(f"OpenBao inacessível em {ADDR} ({e.reason}) — cd openbao && docker compose up -d --wait")


def approle_login(role_id, secret_id):
    return call("POST", "auth/approle/login", {"role_id": role_id, "secret_id": secret_id})["auth"]["client_token"]


def require_unsealed():
    s = call("GET", "sys/seal-status")
    if not s["initialized"]:
        die("OpenBao não inicializado — scripts/cp-secrets init")
    if s["sealed"]:
        die("OpenBao selado — scripts/cp-secrets unseal")


def operator_token():
    require_unsealed()
    if not BOOTSTRAP.exists():
        die(f"{BOOTSTRAP} não existe (gerado pelo init)")
    check_private(BOOTSTRAP)
    c = read_env_file(BOOTSTRAP)
    return approle_login(c["BAO_ROLE_ID"], c["BAO_SECRET_ID"])


# ---------- init / unseal / status ----------

def unseal_with(keys):
    for k in keys:
        s = call("POST", "sys/unseal", {"key": k})
        if not s["sealed"]:
            return s
    return s


def wait_active(timeout=30):
    """Depois do unseal o nó leva alguns instantes até ficar ativo (antes disso a API devolve 500)."""
    import time
    for _ in range(timeout):
        try:
            with urllib.request.urlopen(f"{ADDR}/v1/sys/health", timeout=3) as r:
                if r.status == 200:
                    return
        except urllib.error.URLError:
            pass
        time.sleep(1)
    die("OpenBao não ficou ativo após o unseal")


def cmd_init():
    s = call("GET", "sys/seal-status")
    if s["initialized"]:
        # Retomada: se o bootstrap caiu no meio, o token root ainda está no .init.json.
        if not INIT_FILE.exists() or "root_token" not in json.loads(INIT_FILE.read_text()):
            die("já inicializado e bootstrap concluído (use unseal/status)")
        init_doc = json.loads(INIT_FILE.read_text())
        print("[..] retomando bootstrap interrompido")
        if s["sealed"]:
            unseal_with(init_doc["unseal_keys_b64"][:2])
    else:
        if INIT_FILE.exists():
            die(f"{INIT_FILE} já existe — não sobrescrevo chaves")
        res = call("POST", "sys/init", {"secret_shares": 3, "secret_threshold": 2})
        init_doc = {"unseal_keys_b64": res["keys_base64"], "threshold": 2,
                    "note": "Guardar no gerenciador de senhas e apagar deste disco.",
                    "root_token": res["root_token"]}  # só até o bootstrap terminar (removido no fim)
        write_private(INIT_FILE, json.dumps(init_doc, indent=2))
        print(f"[ok] inicializado (3 chaves, 2 para abrir) → {INIT_FILE.relative_to(ROOT)} (600)")
        unseal_with(res["keys_base64"][:2])
    wait_active()
    print("[ok] aberto e ativo")
    root = init_doc["root_token"]
    if "file/" not in call("GET", "sys/audit", token=root).get("data", {}):
        die("audit device 'file' não está ativo (ver openbao/config.hcl)")
    print("[ok] audit device file ativo (config.hcl) → /openbao/logs/audit.log")
    mounts = call("GET", "sys/mounts", token=root).get("data", {})
    if "kv/" not in mounts:
        call("POST", "sys/mounts/kv", {"type": "kv", "options": {"version": "2"}}, token=root)
    print("[ok] KV v2 em kv/")
    if "approle/" not in call("GET", "sys/auth", token=root).get("data", {}):
        call("POST", "sys/auth/approle", {"type": "approle"}, token=root)
    print("[ok] auth approle")
    call("PUT", "sys/policies/acl/cp-admin", {"policy": 'path "*" { capabilities = ["create","read","update","patch","delete","list","sudo"] }'}, token=root)
    call("POST", f"auth/approle/role/{OPERATOR}", {"token_policies": ["cp-admin"], "token_ttl": "1h",
         "token_max_ttl": "4h", "secret_id_ttl": "0", "token_type": "service"}, token=root)
    role_id = call("GET", f"auth/approle/role/{OPERATOR}/role-id", token=root)["data"]["role_id"]
    secret_id = call("POST", f"auth/approle/role/{OPERATOR}/secret-id", {"metadata": json.dumps({"by": "cp-secrets init"})}, token=root)["data"]["secret_id"]
    write_private(BOOTSTRAP, f"BAO_ROLE_ID={role_id}\nBAO_SECRET_ID={secret_id}\n")
    print(f"[ok] operador {OPERATOR} (AppRole, policy cp-admin) → {BOOTSTRAP.relative_to(ROOT)} (600)")
    call("POST", "auth/token/revoke-self", token=root)
    del init_doc["root_token"]
    write_private(INIT_FILE, json.dumps(init_doc, indent=2))
    print("[ok] token root revogado (novo root, se um dia precisar: bao operator generate-root com as chaves)")


def cmd_unseal():
    s = call("GET", "sys/seal-status")
    if not s["sealed"]:
        print("já aberto")
        return
    if INIT_FILE.exists():
        check_private(INIT_FILE)
        keys = json.loads(INIT_FILE.read_text())["unseal_keys_b64"][: s["t"]]
    else:
        keys = [getpass.getpass(f"chave de unseal {i + 1}/{s['t']}: ") for i in range(s["t"])]
    s = unseal_with(keys)
    if s["sealed"]:
        die(f"ainda selado ({s['progress']}/{s['t']})")
    wait_active()
    print("aberto")


def cmd_status():
    s = call("GET", "sys/seal-status")
    print(f"OpenBao {s.get('version')} — inicializado={s['initialized']} selado={s['sealed']} storage={s.get('storage_type')}")
    if s["initialized"] and not s["sealed"] and BOOTSTRAP.exists():
        tok = operator_token()
        audits = call("GET", "sys/audit", token=tok)
        print("audit devices: " + (", ".join(audits.get("data", audits).keys()) or "NENHUM"))
    if INIT_FILE.exists():
        print(f"ATENÇÃO: {INIT_FILE.relative_to(ROOT)} ainda está em disco — mover para o gerenciador de senhas")


# ---------- plan / apply ----------

def policy_name(slug, env):
    return f"{slug}-{env}-read"


def policy_hcl(slug, env):
    return (f'path "kv/data/{slug}/{env}" {{ capabilities = ["read"] }}\n'
            f'path "kv/metadata/{slug}/{env}" {{ capabilities = ["read"] }}\n')


class Applier:
    def __init__(self, dry):
        self.dry = dry
        self.seen = set()
        self.tok = operator_token()

    def step(self, msg):
        print(("  [plan] " if self.dry else "  [ok]   ") + msg)

    def write(self, method, path, body):
        if not self.dry:
            call(method, path, body, token=self.tok)

    def ensure_policy(self, slug, env):
        name, want = policy_name(slug, env), policy_hcl(slug, env)
        cur = call("GET", f"sys/policies/acl/{name}", token=self.tok, ok404=True)
        if cur and cur["data"]["policy"] == want:
            return name
        if (name, self.dry) not in self.seen:
            self.step(f"policy {name} (lê só kv/{slug}/{env})")
        self.seen.add((name, self.dry))
        self.write("PUT", f"sys/policies/acl/{name}", {"policy": want})
        return name

    def ensure_runtime(self, slug, rt):
        ident, env = rt["identity"], rt["environment"]
        pol = self.ensure_policy(slug, env)
        want = {"token_policies": [pol], "token_ttl": "1h", "token_max_ttl": "24h", "secret_id_ttl": "0"}
        cur = call("GET", f"auth/approle/role/{ident}", token=self.tok, ok404=True)
        if not cur or cur["data"]["token_policies"] != [pol]:
            self.step(f"AppRole {ident} → policy {pol}")
            self.write("POST", f"auth/approle/role/{ident}", want)
        cred = RUNTIME_DIR / f"{ident}.env"
        if cred.exists():
            return
        self.step(f"credencial de runtime → {cred.relative_to(ROOT)} (600)")
        if self.dry:
            return
        role_id = call("GET", f"auth/approle/role/{ident}/role-id", token=self.tok)["data"]["role_id"]
        secret_id = call("POST", f"auth/approle/role/{ident}/secret-id", {"metadata": json.dumps({"by": "cp-secrets apply"})}, token=self.tok)["data"]["secret_id"]
        write_private(cred, f"BAO_ADDR={ADDR}\nBAO_SECRET_PATH=kv/data/{slug}/{env}\n"
                            f"BAO_ROLE_ID={role_id}\nBAO_SECRET_ID={secret_id}\n")

    def import_env(self, slug, repo_path, imp):
        env_file = repo_path / imp["file"]
        env = imp["environment"]
        if not env_file.exists():
            print(f"import {env_file}: arquivo não existe (ok se o .env já saiu do disco)")
            return
        local = read_env_file(env_file)
        cur = call("GET", f"kv/data/{slug}/{env}", token=self.tok, ok404=True)
        remote = (cur or {}).get("data", {}).get("data") or {}
        new = sorted(k for k in local if k not in remote)
        changed = sorted(k for k in local if k in remote and remote[k] != local[k])
        print(f"import {env_file.name} → kv/{slug}/{env}: {len(new)} novas, {len(changed)} diferentes, "
              f"{len(local) - len(new) - len(changed)} iguais")
        if new:
            self.step("criar: " + ", ".join(new))
            merged = {**remote, **{k: local[k] for k in new}}
            self.write("POST", f"kv/data/{slug}/{env}", {"data": merged})
        if changed:
            print("  [aviso] diferem do OpenBao (mantido o valor do OpenBao): " + ", ".join(changed))
        only = sorted(k for k in remote if k not in local)
        if only:
            print("  [info]  só no OpenBao: " + ", ".join(only))


def cmd_apply(dry):
    cfg = tomllib.loads(CONFIG.read_text())
    a = Applier(dry)
    print(f"OpenBao {ADDR} — {'PLAN (nada alterado)' if dry else 'APPLY'}")
    for p in cfg.get("project", []):
        print(f"projeto {p['slug']}: ambientes {', '.join(p['environments'])}")
        for env in p["environments"]:
            a.ensure_policy(p["slug"], env)
        for rt in p.get("runtime", []):
            a.ensure_runtime(p["slug"], rt)
        for repo in p.get("repo", []):
            path = Path(os.path.expanduser(repo["path"]))
            if repo.get("import_env"):
                a.import_env(p["slug"], path, repo["import_env"])


# ---------- run ----------

def cmd_run(ident, argv):
    if not argv:
        die("uso: cp-secrets run <identidade> -- <comando>")
    cred = RUNTIME_DIR / f"{ident}.env"
    if not cred.exists():
        die(f"{cred} não existe (scripts/cp-secrets apply)")
    check_private(cred)
    c = read_env_file(cred)
    require_unsealed()
    tok = approle_login(c["BAO_ROLE_ID"], c["BAO_SECRET_ID"])
    data = call("GET", c["BAO_SECRET_PATH"].removeprefix("/"), token=tok)["data"]["data"]
    call("POST", "auth/token/revoke-self", token=tok)
    print(f"cp-secrets: {len(data)} variáveis de {c['BAO_SECRET_PATH']} ({ident})", file=sys.stderr)
    env = {**os.environ, **data}
    for k in ("BAO_ROLE_ID", "BAO_SECRET_ID"):
        env.pop(k, None)
    os.execvpe(argv[0], argv, env)


# ---------- backup ----------

def cmd_backup():
    tok = operator_token()
    req = urllib.request.Request(f"{ADDR}/v1/sys/storage/raft/snapshot", headers={"X-Vault-Token": tok})
    with urllib.request.urlopen(req, timeout=120) as resp:
        data = resp.read()
    name = datetime.now(timezone.utc).strftime("raft-%Y%m%dT%H%M%SZ.snap")
    dest = BAO / "backups" / name
    dest.parent.mkdir(mode=0o700, exist_ok=True)
    fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(data)
    print(f"[ok] {dest.relative_to(ROOT)} ({len(data)} bytes) — restaurar exige as chaves de unseal")


# ---------- audit ----------

def cmd_audit(hours):
    since = (datetime.now(timezone.utc) - timedelta(hours=hours)).strftime("%Y-%m-%dT%H:%M:%S")
    out = subprocess.run(["docker", "compose", "exec", "-T", "bao", "cat", "/openbao/logs/audit.log"],
                         cwd=BAO, capture_output=True, text=True)
    if out.returncode != 0:
        die(f"não consegui ler o audit log: {out.stderr.strip()[:200]}")
    by_actor, reads, denied = Counter(), Counter(), Counter()
    total = 0
    for line in out.stdout.splitlines():
        try:
            e = json.loads(line)
        except json.JSONDecodeError:
            continue
        if e.get("type") != "response":
            continue
        if e.get("time", "")[:19] < since:  # RFC3339 UTC: comparação de texto basta
            continue
        total += 1
        auth = e.get("auth") or {}
        meta = auth.get("metadata") or {}
        actor = meta.get("role_name") or auth.get("display_name") or "anônimo"
        req = e.get("request") or {}
        path, op = req.get("path", "?"), req.get("operation", "?")
        by_actor[(actor, op, path)] += 1
        err = (e.get("error") or "").split("*")[-1].strip()
        if path.startswith("kv/data/") and op == "read" and not err:
            reads[(actor, path.removeprefix("kv/data/"))] += 1
        if err:
            denied[(actor, f"{op} {path}", err[:60])] += 1
    print(f"audit log OpenBao — últimas {hours}h — {total} respostas")
    print("leitura de segredos (ator → projeto/ambiente):")
    for (actor, path), n in sorted(reads.items(), key=lambda x: -x[1]):
        print(f"  {n:5d}  {actor:28s} {path}")
    if denied:
        print("NEGADOS / erros:")
        for (actor, path, err), n in sorted(denied.items(), key=lambda x: -x[1]):
            print(f"  {n:5d}  {actor:28s} {path}  {err}")
    print("todas as operações:")
    for (actor, op, path), n in sorted(by_actor.items(), key=lambda x: -x[1])[:30]:
        print(f"  {n:5d}  {actor:28s} {op:7s} {path}")


if __name__ == "__main__":
    args = sys.argv[1:] or ["status"]
    cmd = args[0]
    if cmd == "status":
        cmd_status()
    elif cmd == "init":
        cmd_init()
    elif cmd == "unseal":
        cmd_unseal()
    elif cmd in ("plan", "apply"):
        cmd_apply(dry=cmd == "plan")
    elif cmd == "run" and len(args) >= 2:
        rest = args[2:]
        cmd_run(args[1], rest[1:] if rest[:1] == ["--"] else rest)
    elif cmd == "backup":
        cmd_backup()
    elif cmd == "audit":
        cmd_audit(int(args[1]) if len(args) > 1 else 24)
    else:
        print(__doc__)
        sys.exit(2)
