#!/usr/bin/env python3
"""Segredos do control plane no OpenBao (ADR 062/063), a partir de openbao/secrets.toml (estado desejado).
Layout: kv/<cliente>/<projeto>/<ambiente> e kv/<cliente>/_providers/<provedor>.

  cp-secrets status                 selo, versão, mounts de auditoria
  cp-secrets init                   1x: inicializa, abre, liga audit/kv/approle, cria o operador e revoga o root
  cp-secrets unseal                 abre o cofre depois de reiniciar (chaves do .init.json ou digitadas)
  cp-secrets plan | apply           policies + AppRoles (runtime e sync) + import de .env + migração de layout
  cp-secrets keys <cli>/<proj>/<env>      nomes e versão (nunca valores)
  cp-secrets secret gen|set <cli>/<proj>/<env> CHAVE   gera (interna) ou grava (de um painel) numa nova versão
  cp-secrets run <identidade> -- <cmd>    injeta os segredos do ambiente no processo (dev local; sem .env em disco)
  cp-secrets provider set <cli> <prov> [campo=valor ...] [--stdin campo]   grava credencial de operação
  cp-secrets provider list <cli>          provedores e campos (sem valores)
  cp-secrets provider exec <cli> <prov> -- <cmd>   roda o comando com CP_<CAMPO> no ambiente
  cp-secrets sync plan | apply [<cli>[/<proj>[/<target>]]] [--redeploy]   empurra para os destinos + redeploy (push)
  cp-secrets offboard <cli> [--apply --yes <cli>] [--out arquivo]   fim de contrato: exporta e revoga
  cp-secrets audit [horas]          quem leu/alterou o quê (audit log do OpenBao)
  cp-secrets backup                 snapshot do raft (cifrado) em openbao/backups/ — copiar para fora da máquina

Nunca imprime valores de segredo: só nomes, contagens, versões e ids.
"""
import getpass
import json
import os
import stat
import subprocess
import sys
import tomllib
import urllib.error
import urllib.parse
import urllib.request
import uuid
from collections import Counter
from datetime import datetime, timedelta, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import cp_providers  # noqa: E402

ROOT = Path(__file__).resolve().parent.parent
BAO = ROOT / "openbao"
CONFIG = BAO / "secrets.toml"
INIT_FILE = BAO / ".init.json"
BOOTSTRAP = BAO / ".bootstrap.env"
RUNTIME_DIR = BAO / "runtime"
EXPORTS = BAO / "exports"
ADDR = os.environ.get("CP_BAO_ADDR", "http://127.0.0.1:8200")
OPERATOR = "control-plane-bootstrap"
HOME_CLIENT = "easygoal"  # a própria Easy Goal: nunca passa por offboard


def die(msg):
    print(f"erro: {msg}", file=sys.stderr)
    sys.exit(1)


def read_env_file(path):
    """KEY=VALUE simples (aspas removidas, comentários ignorados). Valores nunca são impressos."""
    out = {}
    for raw in Path(path).read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, val = line.split("=", 1)
        key = key.removeprefix("export ").strip()
        val = val.strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in "'\"":
            val = val[1:-1]
        out[key] = val
    return out


def write_private(path, content):
    path.parent.mkdir(mode=0o700, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(content)


def check_private(path):
    mode = stat.S_IMODE(path.stat().st_mode)
    if mode & 0o077:
        die(f"{path} precisa ser 600 (está {oct(mode)}): chmod 600 {path}")


def call(method, path, body=None, token=None, ok404=False):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(f"{ADDR}/v1/{path}", data=data, method=method)
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("X-Vault-Token", token)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        if ok404 and e.code == 404:
            return None
        detail = e.read().decode(errors="replace")[:300]
        die(f"{method} {path} → {e.code}: {detail}")
    except urllib.error.URLError as e:
        die(f"OpenBao inacessível em {ADDR} ({e.reason}) — cd openbao && docker compose up -d --wait")


def approle_login(role_id, secret_id):
    return call("POST", "auth/approle/login", {"role_id": role_id, "secret_id": secret_id})["auth"]["client_token"]


def require_unsealed():
    s = call("GET", "sys/seal-status")
    if not s["initialized"]:
        die("OpenBao não inicializado — scripts/cp-secrets init")
    if s["sealed"]:
        die("OpenBao selado — scripts/cp-secrets unseal")


def operator_token():
    require_unsealed()
    if not BOOTSTRAP.exists():
        die(f"{BOOTSTRAP} não existe (gerado pelo init)")
    check_private(BOOTSTRAP)
    c = read_env_file(BOOTSTRAP)
    return approle_login(c["BAO_ROLE_ID"], c["BAO_SECRET_ID"])


# ---------- init / unseal / status ----------

def unseal_with(keys):
    for k in keys:
        s = call("POST", "sys/unseal", {"key": k})
        if not s["sealed"]:
            return s
    return s


def wait_active(timeout=30):
    """Depois do unseal o nó leva alguns instantes até ficar ativo (antes disso a API devolve 500)."""
    import time
    for _ in range(timeout):
        try:
            with urllib.request.urlopen(f"{ADDR}/v1/sys/health", timeout=3) as r:
                if r.status == 200:
                    return
        except urllib.error.URLError:
            pass
        time.sleep(1)
    die("OpenBao não ficou ativo após o unseal")


def cmd_init():
    s = call("GET", "sys/seal-status")
    if s["initialized"]:
        # Retomada: se o bootstrap caiu no meio, o token root ainda está no .init.json.
        if not INIT_FILE.exists() or "root_token" not in json.loads(INIT_FILE.read_text()):
            die("já inicializado e bootstrap concluído (use unseal/status)")
        init_doc = json.loads(INIT_FILE.read_text())
        print("[..] retomando bootstrap interrompido")
        if s["sealed"]:
            unseal_with(init_doc["unseal_keys_b64"][:2])
    else:
        if INIT_FILE.exists():
            die(f"{INIT_FILE} já existe — não sobrescrevo chaves")
        res = call("POST", "sys/init", {"secret_shares": 3, "secret_threshold": 2})
        init_doc = {"unseal_keys_b64": res["keys_base64"], "threshold": 2,
                    "note": "Guardar no gerenciador de senhas e apagar deste disco.",
                    "root_token": res["root_token"]}  # só até o bootstrap terminar (removido no fim)
        write_private(INIT_FILE, json.dumps(init_doc, indent=2))
        print(f"[ok] inicializado (3 chaves, 2 para abrir) → {INIT_FILE.relative_to(ROOT)} (600)")
        unseal_with(res["keys_base64"][:2])
    wait_active()
    print("[ok] aberto e ativo")
    root = init_doc["root_token"]
    if "file/" not in call("GET", "sys/audit", token=root).get("data", {}):
        die("audit device 'file' não está ativo (ver openbao/config.hcl)")
    print("[ok] audit device file ativo (config.hcl) → /openbao/logs/audit.log")
    mounts = call("GET", "sys/mounts", token=root).get("data", {})
    if "kv/" not in mounts:
        call("POST", "sys/mounts/kv", {"type": "kv", "options": {"version": "2"}}, token=root)
    print("[ok] KV v2 em kv/")
    if "approle/" not in call("GET", "sys/auth", token=root).get("data", {}):
        call("POST", "sys/auth/approle", {"type": "approle"}, token=root)
    print("[ok] auth approle")
    call("PUT", "sys/policies/acl/cp-admin", {"policy": 'path "*" { capabilities = ["create","read","update","patch","delete","list","sudo"] }'}, token=root)
    call("POST", f"auth/approle/role/{OPERATOR}", {"token_policies": ["cp-admin"], "token_ttl": "1h",
         "token_max_ttl": "4h", "secret_id_ttl": "0", "token_type": "service"}, token=root)
    role_id = call("GET", f"auth/approle/role/{OPERATOR}/role-id", token=root)["data"]["role_id"]
    secret_id = call("POST", f"auth/approle/role/{OPERATOR}/secret-id", {"metadata": json.dumps({"by": "cp-secrets init"})}, token=root)["data"]["secret_id"]
    write_private(BOOTSTRAP, f"BAO_ROLE_ID={role_id}\nBAO_SECRET_ID={secret_id}\n")
    print(f"[ok] operador {OPERATOR} (AppRole, policy cp-admin) → {BOOTSTRAP.relative_to(ROOT)} (600)")
    call("POST", "auth/token/revoke-self", token=root)
    del init_doc["root_token"]
    write_private(INIT_FILE, json.dumps(init_doc, indent=2))
    print("[ok] token root revogado (novo root, se um dia precisar: bao operator generate-root com as chaves)")


def cmd_unseal():
    s = call("GET", "sys/seal-status")
    if not s["sealed"]:
        print("já aberto")
        return
    if INIT_FILE.exists():
        check_private(INIT_FILE)
        keys = json.loads(INIT_FILE.read_text())["unseal_keys_b64"][: s["t"]]
    else:
        keys = [getpass.getpass(f"chave de unseal {i + 1}/{s['t']}: ") for i in range(s["t"])]
    s = unseal_with(keys)
    if s["sealed"]:
        die(f"ainda selado ({s['progress']}/{s['t']})")
    wait_active()
    print("aberto")


def cmd_status():
    s = call("GET", "sys/seal-status")
    print(f"OpenBao {s.get('version')} — inicializado={s['initialized']} selado={s['sealed']} storage={s.get('storage_type')}")
    if s["initialized"] and not s["sealed"] and BOOTSTRAP.exists():
        tok = operator_token()
        audits = call("GET", "sys/audit", token=tok)
        print("audit devices: " + (", ".join(audits.get("data", audits).keys()) or "NENHUM"))
    if INIT_FILE.exists():
        print(f"ATENÇÃO: {INIT_FILE.relative_to(ROOT)} ainda está em disco — mover para o gerenciador de senhas")


# ---------- estado desejado ----------

def load_config():
    return tomllib.loads(CONFIG.read_text())


def iter_projects(cfg):
    for c in cfg.get("client", []):
        for p in c.get("project", []):
            yield c, p


def find_client(cfg, slug):
    for c in cfg.get("client", []):
        if c["slug"] == slug:
            return c
    die(f"cliente {slug} não está em {CONFIG.name}")


def kv_path(*parts):
    return "/".join(parts)


def kv_read(tok, path, version=None):
    q = f"?version={version}" if version else ""
    res = call("GET", f"kv/data/{path}{q}", token=tok, ok404=True)
    if not res:
        return None
    return res["data"]


def kv_meta(tok, path):
    res = call("GET", f"kv/metadata/{path}", token=tok, ok404=True)
    return res["data"] if res else None


def kv_list(tok, path):
    res = call("LIST", f"kv/metadata/{path}", token=tok, ok404=True)
    return res["data"]["keys"] if res else []


# ---------- plan / apply ----------

def runtime_policy(c, p, env):
    return f"{c}-{p}-{env}-read"


def runtime_hcl(c, p, env):
    path = kv_path(c, p, env)
    return (f'path "kv/data/{path}" {{ capabilities = ["read"] }}\n'
            f'path "kv/metadata/{path}" {{ capabilities = ["read"] }}\n')


def sync_identity(c):
    return f"cp-sync-{c}"


def sync_hcl(c):
    # Lê tudo do cliente (projetos e _providers) e só anota metadata (versão sincronizada por destino).
    return (f'path "kv/data/{c}/*" {{ capabilities = ["read"] }}\n'
            f'path "kv/metadata/{c}/*" {{ capabilities = ["read", "update", "list"] }}\n')


class Applier:
    def __init__(self, dry):
        self.dry = dry
        self.seen = set()
        self.tok = operator_token()

    def step(self, msg):
        print(("  [plan] " if self.dry else "  [ok]   ") + msg)

    def write(self, method, path, body):
        if not self.dry:
            call(method, path, body, token=self.tok)

    def ensure_policy(self, name, want, why):
        cur = call("GET", f"sys/policies/acl/{name}", token=self.tok, ok404=True)
        if cur and cur["data"]["policy"] == want:
            return name
        if (name, self.dry) not in self.seen:
            self.step(f"policy {name} ({why})")
        self.seen.add((name, self.dry))
        self.write("PUT", f"sys/policies/acl/{name}", {"policy": want})
        return name

    def ensure_approle(self, ident, pol, secret_path, ttl="1h", max_ttl="24h"):
        want = {"token_policies": [pol], "token_ttl": ttl, "token_max_ttl": max_ttl, "secret_id_ttl": "0"}
        cur = call("GET", f"auth/approle/role/{ident}", token=self.tok, ok404=True)
        if not cur or cur["data"]["token_policies"] != [pol]:
            self.step(f"AppRole {ident} → policy {pol}")
            self.write("POST", f"auth/approle/role/{ident}", want)
        cred = RUNTIME_DIR / f"{ident}.env"
        if cred.exists():
            c = read_env_file(cred)
            if c.get("BAO_SECRET_PATH") != secret_path:
                self.step(f"credencial {cred.name}: caminho → {secret_path}")
                if not self.dry:
                    c["BAO_SECRET_PATH"] = secret_path
                    write_private(cred, "".join(f"{k}={v}\n" for k, v in c.items()))
            return
        self.step(f"credencial → {cred.relative_to(ROOT)} (600)")
        if self.dry:
            return
        role_id = call("GET", f"auth/approle/role/{ident}/role-id", token=self.tok)["data"]["role_id"]
        secret_id = call("POST", f"auth/approle/role/{ident}/secret-id", {"metadata": json.dumps({"by": "cp-secrets apply"})}, token=self.tok)["data"]["secret_id"]
        write_private(cred, f"BAO_ADDR={ADDR}\nBAO_SECRET_PATH={secret_path}\n"
                            f"BAO_ROLE_ID={role_id}\nBAO_SECRET_ID={secret_id}\n")

    def migrate_legacy(self, c, p, legacy, envs):
        """Uma vez: kv/<legacy>/<env> (layout do ADR 062) → kv/<cliente>/<projeto>/<env>."""
        for env in envs:
            old, new = kv_path(legacy, env), kv_path(c, p, env)
            src = kv_read(self.tok, old)
            if not src:
                if call("GET", f"sys/policies/acl/{legacy}-{env}-read", token=self.tok, ok404=True):
                    self.step(f"apagar policy {legacy}-{env}-read (layout antigo, sem dados)")
                    self.write("DELETE", f"sys/policies/acl/{legacy}-{env}-read", None)
                continue
            dst = kv_read(self.tok, new)
            if dst and dst["data"] != src["data"]:
                print(f"  [aviso] kv/{old} e kv/{new} existem e diferem — resolver à mão (nada alterado)")
                continue
            if not dst:
                self.step(f"migrar kv/{old} → kv/{new} ({len(src['data'])} chaves)")
                self.write("POST", f"kv/data/{new}", {"data": src["data"]})
            if not self.dry:
                if kv_read(self.tok, new)["data"] != src["data"]:
                    die(f"cópia para kv/{new} não confere — kv/{old} mantido")
            self.step(f"apagar kv/{old} (todas as versões) e policy {legacy}-{env}-read")
            self.write("DELETE", f"kv/metadata/{old}", None)
            if call("GET", f"sys/policies/acl/{legacy}-{env}-read", token=self.tok, ok404=True):
                self.write("DELETE", f"sys/policies/acl/{legacy}-{env}-read", None)

    def import_env(self, path, repo_path, imp):
        env_file = repo_path / imp["file"]
        if not env_file.exists():
            print(f"import {env_file}: arquivo não existe (ok se o .env já saiu do disco)")
            return
        local = read_env_file(env_file)
        cur = kv_read(self.tok, path)
        remote = (cur or {}).get("data") or {}
        new = sorted(k for k in local if k not in remote)
        changed = sorted(k for k in local if k in remote and remote[k] != local[k])
        print(f"import {env_file.name} → kv/{path}: {len(new)} novas, {len(changed)} diferentes, "
              f"{len(local) - len(new) - len(changed)} iguais")
        if new:
            self.step("criar: " + ", ".join(new))
            merged = {**remote, **{k: local[k] for k in new}}
            self.write("POST", f"kv/data/{path}", {"data": merged})
        if changed:
            print("  [aviso] diferem do OpenBao (mantido o valor do OpenBao): " + ", ".join(changed))
        only = sorted(k for k in remote if k not in local)
        if only:
            print("  [info]  só no OpenBao: " + ", ".join(only))


def cmd_apply(dry):
    cfg = load_config()
    a = Applier(dry)
    print(f"OpenBao {ADDR} — {'PLAN (nada alterado)' if dry else 'APPLY'}")
    for c in cfg.get("client", []):
        cs = c["slug"]
        print(f"cliente {cs}")
        pol = a.ensure_policy(sync_identity(cs), sync_hcl(cs), f"sync: lê kv/{cs}/*")
        a.ensure_approle(sync_identity(cs), pol, f"kv/data/{cs}", ttl="15m", max_ttl="1h")
        for p in c.get("project", []):
            ps = p["slug"]
            print(f"  projeto {ps}: ambientes {', '.join(p['environments'])}")
            if p.get("legacy_path"):
                a.migrate_legacy(cs, ps, p["legacy_path"], p["environments"])
            for env in p["environments"]:
                a.ensure_policy(runtime_policy(cs, ps, env), runtime_hcl(cs, ps, env), f"lê só kv/{cs}/{ps}/{env}")
            for rt in p.get("runtime", []):
                env = rt["environment"]
                a.ensure_approle(rt["identity"], runtime_policy(cs, ps, env), f"kv/data/{kv_path(cs, ps, env)}")
            for repo in p.get("repo", []):
                path = Path(os.path.expanduser(repo["path"]))
                if repo.get("import_env"):
                    a.import_env(kv_path(cs, ps, repo["import_env"]["environment"]), path, repo["import_env"])


def cmd_keys(path):
    tok = operator_token()
    meta = kv_meta(tok, path)
    data = kv_read(tok, path)
    if not data:
        die(f"kv/{path} não existe")
    print(f"kv/{path} — versão {meta['current_version']}, {len(data['data'])} chaves")
    for k in sorted(data["data"]):
        print(f"  {k}")
    sync = {k: v for k, v in (meta.get("custom_metadata") or {}).items() if k.startswith("sync.")}
    for k, v in sorted(sync.items()):
        print(f"  [{k}] {v}")


def cmd_secret(args):
    """Escreve uma chave numa nova versão do caminho: `gen` (interna, gerada aqui) ou `set` (vinda de um painel)."""
    if len(args) < 3 or args[0] not in ("gen", "set"):
        die("uso: cp-secrets secret gen <cli>/<proj>/<env> CHAVE [--bytes 32] [--format hex|base64]\n"
            "     cp-secrets secret set <cli>/<proj>/<env> CHAVE [--stdin]")
    sub, path, key = args[:3]
    if path.count("/") != 2 or "_providers" in path:
        die("caminho deve ser <cliente>/<projeto>/<ambiente> (credencial de operação: cp-secrets provider set)")
    rest = args[3:]
    if sub == "gen":
        import base64
        import secrets as rnd
        n = int(rest[rest.index("--bytes") + 1]) if "--bytes" in rest else 32
        fmt = rest[rest.index("--format") + 1] if "--format" in rest else "hex"
        raw = rnd.token_bytes(n)
        value = raw.hex() if fmt == "hex" else base64.b64encode(raw).decode()
    elif "--stdin" in rest:
        value = sys.stdin.readline().rstrip("\n")
    else:
        value = getpass.getpass(f"{key} (oculto): ")
    if not value:
        die("valor vazio")
    tok = operator_token()
    cur = (kv_read(tok, path) or {}).get("data") or {}
    verb = "trocada" if key in cur else "criada"
    res = call("POST", f"kv/data/{path}", {"data": {**cur, key: value}}, token=tok)
    print(f"[ok] kv/{path}: {key} {verb} → versão {res['data']['version']} (propagar: cp-secrets sync plan)")


# ---------- provedores (credenciais de operação) ----------

def provider_cfg(c, name):
    for pr in c.get("provider", []):
        if pr["name"] == name:
            if pr["kind"] not in cp_providers.KINDS:
                die(f"provedor {name}: kind {pr['kind']} desconhecido ({', '.join(cp_providers.KINDS)})")
            return pr
    die(f"provedor {name} não declarado em [[client.provider]] de {c['slug']}")


def cmd_provider(args):
    if len(args) < 2:
        die("uso: cp-secrets provider set|list|exec ...")
    sub, cs = args[0], args[1]
    c = find_client(load_config(), cs)
    tok = operator_token()
    if sub == "list":
        for pr in c.get("provider", []):
            path = kv_path(cs, "_providers", pr["name"])
            d = kv_read(tok, path)
            have = sorted((d or {}).get("data", {}))
            when = (d or {}).get("metadata", {}).get("created_time", "—")[:19]
            print(f"{pr['name']:20s} {pr['kind']:8s} campos={','.join(have) or '(vazio)'} atualizado={when}")
        return
    if len(args) < 3:
        die(f"uso: cp-secrets provider {sub} <cliente> <provedor> ...")
    pr = provider_cfg(c, args[2])
    path = kv_path(cs, "_providers", pr["name"])
    fields = cp_providers.KINDS[pr["kind"]].fields
    rest = args[3:]
    if sub == "set":
        cur = (kv_read(tok, path) or {}).get("data") or {}
        vals, stdin_field = {}, None
        it = iter(rest)
        for a in it:
            if a == "--stdin":
                stdin_field = next(it, None)
            elif "=" in a:
                k, v = a.split("=", 1)
                if fields.get(k):
                    die(f"{k} é segredo: use --stdin {k} ou deixe o prompt pedir (nunca na linha de comando)")
                vals[k] = v
        for k, secret in fields.items():
            if k in vals:
                continue
            if k == stdin_field:
                vals[k] = sys.stdin.readline().strip()
            elif secret:
                vals[k] = getpass.getpass(f"{pr['name']}.{k} (oculto, Enter mantém o atual): ").strip()
            else:
                vals[k] = input(f"{pr['name']}.{k} [{cur.get(k, '')}]: ").strip()
            if not vals[k]:
                if k in cur:
                    vals[k] = cur[k]
                else:
                    vals.pop(k)
        unknown = set(vals) - set(fields)
        if unknown:
            die(f"campos desconhecidos para {pr['kind']}: {', '.join(sorted(unknown))}")
        call("POST", f"kv/data/{path}", {"data": vals}, token=tok)
        print(f"[ok] kv/{path}: {', '.join(sorted(vals))}")
    elif sub == "exec":
        argv = rest[1:] if rest[:1] == ["--"] else rest
        if not argv:
            die("uso: cp-secrets provider exec <cliente> <provedor> -- <comando>")
        d = kv_read(tok, path)
        if not d:
            die(f"kv/{path} vazio (cp-secrets provider set {cs} {pr['name']})")
        env = {**os.environ, **{f"CP_{k.upper()}": v for k, v in d["data"].items()}}
        print(f"cp-secrets: CP_{', CP_'.join(k.upper() for k in d['data'])} de kv/{path}", file=sys.stderr)
        os.execvpe(argv[0], argv, env)
    else:
        die(f"provider {sub}: use set, list ou exec")


# ---------- sync (push para os destinos) ----------

def sync_token(cs):
    cred = RUNTIME_DIR / f"{sync_identity(cs)}.env"
    if not cred.exists():
        die(f"{cred} não existe (scripts/cp-secrets apply)")
    check_private(cred)
    c = read_env_file(cred)
    require_unsealed()
    return approle_login(c["BAO_ROLE_ID"], c["BAO_SECRET_ID"])


def parse_sync_mark(v):
    """custom_metadata sync.<target> = "v=<versão> at=<iso>" """
    out = dict(part.split("=", 1) for part in (v or "").split() if "=" in part)
    at = datetime.fromisoformat(out["at"]) if "at" in out else None
    return (int(out["v"]) if "v" in out else None), at


def sync_target(tok, cs, ps, t, providers, dry, force_redeploy=False):
    name, env = t["name"], t["environment"]
    path = kv_path(cs, ps, env)
    label = f"{cs}/{ps}/{name} ({t['provider']} ← kv/{path})"
    meta = kv_meta(tok, path)
    cur = kv_read(tok, path)
    if not cur:
        print(f"[erro] {label}: kv/{path} vazio")
        return False
    data, version = cur["data"], meta["current_version"]
    keys = t.get("keys") or []
    if not keys:
        print(f"[erro] {label}: target sem 'keys' (allowlist obrigatória)")
        return False
    missing = [k for k in keys if k not in data]
    if missing:
        print(f"[erro] {label}: faltam no cofre: {', '.join(missing)}")
        return False
    custom = meta.get("custom_metadata") or {}
    mark_key = f"sync.{name}"
    last_v, last_at = parse_sync_mark(custom.get(mark_key))
    old = {}
    if last_v:
        prev = kv_read(tok, path, last_v)
        old = (prev or {}).get("data") or {}
    changed_in_vault = {k for k in keys if last_v is None or old.get(k) != data[k]}

    pr = providers[t["provider"]]
    try:
        adapter = cp_providers.KINDS[pr["kind"]](pr["fields"], t)
        dest = adapter.list()
    except cp_providers.ProviderError as e:
        print(f"[erro] {label}: {e}")
        return False
    create, update, drift, same = [], [], [], []
    for k in keys:
        d = dest.get(k)
        if d is None:
            create.append(k)
        elif d["value"] is not None:
            if d["value"] != data[k]:
                update.append(k)
                if last_v and d["value"] != old.get(k):
                    drift.append(k)  # alguém mudou direto no destino
            else:
                same.append(k)
        else:  # destino não devolve o valor (Vercel)
            if k in changed_in_vault:
                update.append(k)
            elif last_at and d["updated_at"] and d["updated_at"] > last_at + timedelta(seconds=60):
                update.append(k)
                drift.append(k)
            else:
                same.append(k)
    extra = sorted(set(dest) - set(keys))
    print(f"{label}: cofre v{version}, sincronizado {('v' + str(last_v)) if last_v else 'nunca'}")
    for title, ks in (("criar", create), ("atualizar", update)):
        if ks:
            print(f"  {title}: {', '.join(ks)}")
    if drift:
        print(f"  [aviso] divergiu no destino (o cofre vence): {', '.join(drift)}")
    print(f"  iguais: {len(same)}" + (f" | fora da allowlist (não mexo): {', '.join(extra)}" if extra else ""))
    todo = create + update
    # A versão só é anotada depois de um redeploy que deu certo: se a rodada anterior gravou mas
    # falhou no redeploy, o destino tem os valores e a app ainda não — o redeploy continua pendente.
    pending = last_v != version or force_redeploy
    if not todo and pending:
        print("  redeploy pendente (versão do cofre ainda não aplicada na app)" if not force_redeploy
              else "  redeploy forçado (--redeploy)")
    if dry:
        return True
    if todo or pending:
        try:
            if todo:
                adapter.upsert({k: data[k] for k in todo})
                print(f"  [ok] {len(todo)} variáveis gravadas")
            redeployed = t.get("redeploy", True)
            if redeployed:
                adapter.redeploy()
                print("  [ok] redeploy " + ("na fila" if adapter.async_restart else "concluído"))
            if t.get("health_url"):
                if redeployed and adapter.async_restart:
                    cp_providers.wait_http_cycle(t["health_url"])
                    print(f"  [ok] {t['health_url']} saiu do ar e voltou → 200")
                else:
                    cp_providers.wait_http_ok(t["health_url"])
                    print(f"  [ok] {t['health_url']} → 200")
            elif redeployed and adapter.async_restart:
                print("  [aviso] restart assíncrono sem health_url: não confirmo que a app subiu com os valores novos")
        except cp_providers.ProviderError as e:
            print(f"  [erro] {e} — versão sincronizada NÃO foi anotada")
            return False
    custom[mark_key] = f"v={version} at={datetime.now(timezone.utc).isoformat(timespec='seconds')}"
    call("POST", f"kv/metadata/{path}", {"custom_metadata": custom}, token=tok)
    return True


def cmd_sync(args):
    if not args or args[0] not in ("plan", "apply"):
        die("uso: cp-secrets sync plan|apply [<cliente>[/<projeto>[/<target>]]] [--redeploy]")
    dry = args[0] == "plan"
    force = "--redeploy" in args
    args = [a for a in args if a != "--redeploy"]
    sel = (args[1].split("/") if len(args) > 1 else []) + [None, None, None]
    cfg = load_config()
    ok = True
    print(f"sync — {'PLAN (nada alterado)' if dry else 'APPLY'}")
    for c in cfg.get("client", []):
        cs = c["slug"]
        if sel[0] and sel[0] != cs:
            continue
        targets = [(p["slug"], t) for p in c.get("project", []) for t in p.get("target", [])
                   if (not sel[1] or sel[1] == p["slug"]) and (not sel[2] or sel[2] == t["name"])]
        if not targets:
            continue
        tok = sync_token(cs)
        providers = {}
        for pr in c.get("provider", []):
            d = kv_read(tok, kv_path(cs, "_providers", pr["name"]))
            providers[pr["name"]] = {"kind": pr["kind"], "fields": (d or {}).get("data") or {}}
        for ps, t in targets:
            if t["provider"] not in providers or not providers[t["provider"]]["fields"]:
                print(f"[erro] {cs}/{ps}/{t['name']}: provedor {t['provider']} sem credencial "
                      f"(cp-secrets provider set {cs} {t['provider']})")
                ok = False
                continue
            ok = sync_target(tok, cs, ps, t, providers, dry, force) and ok
        call("POST", "auth/token/revoke-self", token=tok)
    if not ok:
        sys.exit(1)


# ---------- offboard (fim de contrato) ----------

def bitwarden_export(client_slug, entries):
    """JSON não cifrado no formato de importação do Bitwarden: uma nota segura por projeto/ambiente."""
    folder = str(uuid.uuid4())
    now = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    items = []
    for path, data in entries:
        items.append({
            "id": str(uuid.uuid4()), "organizationId": None, "folderId": folder, "type": 2, "reprompt": 1,
            "name": path.split("/", 1)[1].replace("/", " / "), "favorite": False, "secureNote": {"type": 0},
            "notes": f"Variáveis de ambiente da aplicação (kv/{path}), exportadas do control plane da Easy Goal em {now}.",
            "fields": [{"name": k, "value": v, "type": 1, "linkedId": None} for k, v in sorted(data.items())],
            "collectionIds": None,
        })
    return {"encrypted": False, "folders": [{"id": folder, "name": f"{client_slug} — segredos de app"}], "items": items}


def cmd_offboard(args):
    if not args:
        die("uso: cp-secrets offboard <cliente> [--apply --yes <cliente>] [--out arquivo]")
    cs = args[0]
    if cs == HOME_CLIENT:
        die("a Easy Goal não passa por offboard")
    apply_ = "--apply" in args
    confirm = args[args.index("--yes") + 1] if "--yes" in args and args.index("--yes") + 1 < len(args) else None
    out = Path(args[args.index("--out") + 1]) if "--out" in args else EXPORTS / f"{cs}-{datetime.now(timezone.utc):%Y%m%dT%H%M%SZ}.bitwarden.json"
    c = find_client(load_config(), cs)
    tok = operator_token()
    print(f"offboard {cs} — {'APPLY' if apply_ else 'PLAN (nada alterado)'}")
    entries = []
    for p in c.get("project", []):
        for env in p["environments"]:
            d = kv_read(tok, kv_path(cs, p["slug"], env))
            if d and d["data"]:
                entries.append((kv_path(cs, p["slug"], env), d["data"]))
    print(f"  exportar {len(entries)} ambientes para o Bitwarden do cliente: " + ", ".join(e[0] for e in entries))
    provs = [(pr, (kv_read(tok, kv_path(cs, "_providers", pr["name"])) or {}).get("data")) for pr in c.get("provider", [])]
    for pr, d in provs:
        print(f"  revogar credencial de operação {pr['name']} ({pr['kind']})" + ("" if d else " — vazia, nada a revogar"))
    idents = [rt["identity"] for p in c.get("project", []) for rt in p.get("runtime", [])] + [sync_identity(cs)]
    pols = [runtime_policy(cs, p["slug"], env) for p in c.get("project", []) for env in p["environments"]] + [sync_identity(cs)]
    print(f"  apagar AppRoles: {', '.join(idents)}")
    print(f"  apagar policies: {', '.join(pols)}")
    print(f"  apagar do cofre: kv/{cs}/* (todas as versões)")
    manual = ["remover a chave SSH do control plane do authorized_keys de cada VPS do cliente",
              "remover os servidores do cliente no Coolify (os containers continuam rodando na VPS dele)",
              "remover os nós do cliente da tailnet (e a tag na ACL)",
              f"importar {out.name} no Bitwarden do cliente e apagar o arquivo (shred -u)",
              f"remover o bloco [[client]] {cs} do {CONFIG.name} (senão o próximo apply recria)"]
    print("  MANUAL depois:" + "".join(f"\n    - {m}" for m in manual))
    if not apply_:
        return
    if confirm != cs:
        die(f"para executar: --apply --yes {cs}")
    cmd_backup()
    EXPORTS.mkdir(mode=0o700, exist_ok=True)
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(bitwarden_export(cs, entries), f, indent=2, ensure_ascii=False)
    print(f"  [ok] export → {out} (600, texto puro: importar e apagar)")
    for pr, d in provs:
        if not d:
            continue
        try:
            msg = cp_providers.KINDS[pr["kind"]](d, {"project": "-", "uuid": "-"}).revoke()
            print(f"  [ok] {pr['name']}: {msg}")
        except cp_providers.ProviderError as e:
            print(f"  [aviso] {pr['name']}: não revoguei ({e}) — revogar no painel do provedor")
    for ident in idents:
        call("DELETE", f"auth/approle/role/{ident}", token=tok, ok404=True)
        cred = RUNTIME_DIR / f"{ident}.env"
        if cred.exists():
            cred.unlink()
    for pol in pols:
        call("DELETE", f"sys/policies/acl/{pol}", token=tok, ok404=True)

    def purge(prefix):
        for k in kv_list(tok, prefix):
            if k.endswith("/"):
                purge(prefix + "/" + k.rstrip("/"))
            else:
                call("DELETE", f"kv/metadata/{prefix}/{k}", token=tok)
    purge(cs)
    left = kv_list(tok, cs)
    print(f"  [ok] AppRoles, policies e kv/{cs}/* apagados" + (f" (sobrou: {left})" if left else ""))


# ---------- run ----------

def cmd_run(ident, argv):
    if not argv:
        die("uso: cp-secrets run <identidade> -- <comando>")
    cred = RUNTIME_DIR / f"{ident}.env"
    if not cred.exists():
        die(f"{cred} não existe (scripts/cp-secrets apply)")
    check_private(cred)
    c = read_env_file(cred)
    require_unsealed()
    tok = approle_login(c["BAO_ROLE_ID"], c["BAO_SECRET_ID"])
    data = call("GET", c["BAO_SECRET_PATH"].removeprefix("/"), token=tok)["data"]["data"]
    call("POST", "auth/token/revoke-self", token=tok)
    print(f"cp-secrets: {len(data)} variáveis de {c['BAO_SECRET_PATH']} ({ident})", file=sys.stderr)
    env = {**os.environ, **data}
    for k in ("BAO_ROLE_ID", "BAO_SECRET_ID"):
        env.pop(k, None)
    os.execvpe(argv[0], argv, env)


# ---------- backup ----------

def cmd_backup():
    tok = operator_token()
    req = urllib.request.Request(f"{ADDR}/v1/sys/storage/raft/snapshot", headers={"X-Vault-Token": tok})
    with urllib.request.urlopen(req, timeout=120) as resp:
        data = resp.read()
    name = datetime.now(timezone.utc).strftime("raft-%Y%m%dT%H%M%SZ.snap")
    dest = BAO / "backups" / name
    dest.parent.mkdir(mode=0o700, exist_ok=True)
    fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(data)
    print(f"[ok] {dest.relative_to(ROOT)} ({len(data)} bytes) — restaurar exige as chaves de unseal")


# ---------- audit ----------

def cmd_audit(hours):
    since = (datetime.now(timezone.utc) - timedelta(hours=hours)).strftime("%Y-%m-%dT%H:%M:%S")
    out = subprocess.run(["docker", "compose", "exec", "-T", "bao", "cat", "/openbao/logs/audit.log"],
                         cwd=BAO, capture_output=True, text=True)
    if out.returncode != 0:
        die(f"não consegui ler o audit log: {out.stderr.strip()[:200]}")
    by_actor, reads, denied = Counter(), Counter(), Counter()
    total = 0
    for line in out.stdout.splitlines():
        try:
            e = json.loads(line)
        except json.JSONDecodeError:
            continue
        if e.get("type") != "response":
            continue
        if e.get("time", "")[:19] < since:  # RFC3339 UTC: comparação de texto basta
            continue
        total += 1
        auth = e.get("auth") or {}
        meta = auth.get("metadata") or {}
        actor = meta.get("role_name") or auth.get("display_name") or "anônimo"
        req = e.get("request") or {}
        path, op = req.get("path", "?"), req.get("operation", "?")
        by_actor[(actor, op, path)] += 1
        err = (e.get("error") or "").split("*")[-1].strip()
        if path.startswith("kv/data/") and op == "read" and not err:
            reads[(actor, path.removeprefix("kv/data/"))] += 1
        if err:
            denied[(actor, f"{op} {path}", err[:60])] += 1
    print(f"audit log OpenBao — últimas {hours}h — {total} respostas")
    print("leitura de segredos (ator → projeto/ambiente):")
    for (actor, path), n in sorted(reads.items(), key=lambda x: -x[1]):
        print(f"  {n:5d}  {actor:28s} {path}")
    if denied:
        print("NEGADOS / erros:")
        for (actor, path, err), n in sorted(denied.items(), key=lambda x: -x[1]):
            print(f"  {n:5d}  {actor:28s} {path}  {err}")
    print("todas as operações:")
    for (actor, op, path), n in sorted(by_actor.items(), key=lambda x: -x[1])[:30]:
        print(f"  {n:5d}  {actor:28s} {op:7s} {path}")


if __name__ == "__main__":
    args = sys.argv[1:] or ["status"]
    cmd = args[0]
    if cmd == "status":
        cmd_status()
    elif cmd == "init":
        cmd_init()
    elif cmd == "unseal":
        cmd_unseal()
    elif cmd in ("plan", "apply"):
        cmd_apply(dry=cmd == "plan")
    elif cmd == "keys" and len(args) == 2:
        cmd_keys(args[1])
    elif cmd == "secret":
        cmd_secret(args[1:])
    elif cmd == "provider":
        cmd_provider(args[1:])
    elif cmd == "sync":
        cmd_sync(args[1:])
    elif cmd == "offboard":
        cmd_offboard(args[1:])
    elif cmd == "run" and len(args) >= 2:
        rest = args[2:]
        cmd_run(args[1], rest[1:] if rest[:1] == ["--"] else rest)
    elif cmd == "backup":
        cmd_backup()
    elif cmd == "audit":
        cmd_audit(int(args[1]) if len(args) > 1 else 24)
    else:
        print(__doc__)
        sys.exit(2)
