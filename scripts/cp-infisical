#!/usr/bin/env python3
"""Gerencia o Infisical do control plane a partir de infisical/projects.toml (estado desejado).

  cp-infisical plan     mostra o que mudaria, sem alterar nada
  cp-infisical apply    cria projetos/ambientes/roles/identidades e importa .env de repos (idempotente)
  cp-infisical audit    resume o audit log (quem acessou o quê) das últimas N horas

Autentica com a identidade `control-plane-bootstrap` (infisical/.bootstrap.env, 600, fora do git).
Nunca imprime valores de segredo: só nomes, contagens e ids.
"""
import json
import os
import stat
import sys
import tomllib
import urllib.error
import urllib.parse
import urllib.request
from collections import Counter
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
INF = ROOT / "infisical"
CONFIG = INF / "projects.toml"
BOOTSTRAP = INF / ".bootstrap.env"
RUNTIME_DIR = INF / "runtime"
API = os.environ.get("CP_INFISICAL_URL", "http://localhost:8080")


def die(msg):
    print(f"erro: {msg}", file=sys.stderr)
    sys.exit(1)


def read_env_file(path):
    """KEY=VALUE simples (aspas removidas, comentários ignorados). Valores nunca saem desta função impressos."""
    out = {}
    for raw in Path(path).read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, val = line.split("=", 1)
        key = key.removeprefix("export ").strip()
        val = val.strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in "'\"":
            val = val[1:-1]
        out[key] = val
    return out


def check_private(path):
    mode = stat.S_IMODE(path.stat().st_mode)
    if mode & 0o077:
        die(f"{path} precisa ser 600 (está {oct(mode)}): chmod 600 {path}")


class Client:
    def __init__(self, dry_run):
        self.dry_run = dry_run
        if not BOOTSTRAP.exists():
            die(f"{BOOTSTRAP} não existe (crie a identidade control-plane-bootstrap — ver README)")
        check_private(BOOTSTRAP)
        creds = read_env_file(BOOTSTRAP)
        if not creds.get("INFISICAL_CLIENT_ID") or not creds.get("INFISICAL_CLIENT_SECRET"):
            die(f"{BOOTSTRAP} sem INFISICAL_CLIENT_ID/INFISICAL_CLIENT_SECRET preenchidos")
        login = self.call("POST", "/api/v1/auth/universal-auth/login", {
            "clientId": creds["INFISICAL_CLIENT_ID"], "clientSecret": creds["INFISICAL_CLIENT_SECRET"],
        }, auth=False, write=False)
        self.token = login["accessToken"]
        self.identity_id = self.whoami(creds["INFISICAL_CLIENT_ID"])
        self.org_id = self.call("GET", f"/api/v1/identities/{self.identity_id}")["identity"]["orgId"]

    def whoami(self, client_id):
        # O id da identidade vem no token (JWT); não é segredo, é só o payload.
        import base64
        payload = self.token.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        return json.loads(base64.urlsafe_b64decode(payload))["identityId"]

    def call(self, method, path, body=None, auth=True, write=None, ok404=False):
        write = method != "GET" if write is None else write
        if write and self.dry_run:
            return None
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(API + path, data=data, method=method)
        req.add_header("Content-Type", "application/json")
        if auth:
            req.add_header("Authorization", f"Bearer {self.token}")
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                return json.loads(resp.read() or b"{}")
        except urllib.error.HTTPError as e:
            if ok404 and e.code == 404:
                return None
            detail = e.read().decode(errors="replace")[:300]
            die(f"{method} {path} → {e.code}: {detail}")


def step(dry, msg):
    print(("  [plan] " if dry else "  [ok]   ") + msg)


def ensure_project(c, p):
    found = c.call("GET", f"/api/v1/projects/slug/{p['slug']}", ok404=True)
    if found:
        proj = found.get("project", found)
        print(f"projeto {p['slug']}: existe ({proj['id']})")
        return proj
    step(c.dry_run, f"criar projeto {p['slug']}")
    created = c.call("POST", "/api/v1/projects", {
        "projectName": p["name"], "slug": p["slug"], "projectDescription": p.get("description", ""),
        "type": "secret-manager", "shouldCreateDefaultEnvs": False,
    })
    return created["project"] if created else {"id": None, "environments": []}


def ensure_environments(c, proj, p):
    have = {e["slug"] for e in proj.get("environments", [])}
    for i, env in enumerate(p.get("environments", []), start=1):
        if env["slug"] in have:
            continue
        step(c.dry_run, f"criar ambiente {p['slug']}/{env['slug']}")
        c.call("POST", f"/api/v1/projects/{proj['id']}/environments",
               {"name": env["name"], "slug": env["slug"], "position": i})


def ensure_runtime_identity(c, proj, rt):
    # Role de projeto embutida. Custom role (ler só 1 ambiente) exige plano Enterprise do Infisical; no
    # self-hosted gratuito o isolamento de prod é por projeto separado (ver projects.toml).
    name, env = rt["identity"], rt["environment"]
    role = rt.get("role", "viewer")
    ids = c.call("GET", f"/api/v1/identities?orgId={c.org_id}&limit=100") or {}
    existing = next((i for i in ids.get("identities", []) if (i.get("identity") or i).get("name") == name), None)
    cred_file = RUNTIME_DIR / f"{name}.env"
    if existing:
        print(f"identidade {name}: existe")
        return
    step(c.dry_run, f"criar identidade {name} (org: no-access, projeto: {role}) + credencial em {cred_file.relative_to(ROOT)}")
    if c.dry_run:
        return
    ident = c.call("POST", "/api/v1/identities", {"name": name, "organizationId": c.org_id, "role": "no-access"})
    iid = ident["identity"]["id"]
    c.call("POST", f"/api/v1/auth/universal-auth/identities/{iid}", {
        "accessTokenTTL": 3600, "accessTokenMaxTTL": 86400,
        "lockoutEnabled": True, "lockoutThreshold": 5, "lockoutDurationSeconds": 300, "lockoutCounterResetSeconds": 30,
    })
    c.call("POST", f"/api/v1/projects/{proj['id']}/identity-memberships/{iid}", {"roles": [{"role": role, "isTemporary": False}]})
    ua = c.call("GET", f"/api/v1/auth/universal-auth/identities/{iid}")["identityUniversalAuth"]
    secret = c.call("POST", f"/api/v1/auth/universal-auth/identities/{iid}/client-secrets",
                    {"description": "gerado pelo control-plane", "ttl": 0})["clientSecret"]
    RUNTIME_DIR.mkdir(mode=0o700, exist_ok=True)
    fd = os.open(cred_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(f"INFISICAL_PROJECT_ID={proj['id']}\nINFISICAL_ENV={env}\n"
                f"INFISICAL_CLIENT_ID={ua['clientId']}\nINFISICAL_CLIENT_SECRET={secret}\n")


def link_repo(c, proj, repo):
    path = Path(os.path.expanduser(repo["path"]))
    if not path.is_dir():
        print(f"repo {path}: não encontrado, pulando")
        return
    target = path / ".infisical.json"
    want = {"workspaceId": proj["id"], "defaultEnvironment": repo.get("default_environment", "dev"),
            "gitBranchToEnvironmentMapping": None}
    if target.exists() and json.loads(target.read_text()) == want:
        pass
    else:
        step(c.dry_run, f"escrever {target} (só id do projeto, versionável)")
        if not c.dry_run:
            target.write_text(json.dumps(want, indent=2) + "\n")
    imp = repo.get("import_env")
    if imp:
        import_env(c, proj, path / imp["file"], imp["environment"], imp.get("secret_path", "/"))


def import_env(c, proj, env_file, env, secret_path):
    if not env_file.exists():
        print(f"import {env_file}: arquivo não existe (ok se o .env já saiu do disco)")
        return
    local = read_env_file(env_file)
    remote = {}
    if proj["id"]:
        q = urllib.parse.urlencode({"projectId": proj["id"], "environment": env, "secretPath": secret_path,
                                    "viewSecretValue": "true", "expandSecretReferences": "false"})
        res = c.call("GET", f"/api/v4/secrets?{q}") or {}
        remote = {s["secretKey"]: s.get("secretValue") for s in res.get("secrets", [])}
    new = sorted(k for k in local if k not in remote)
    changed = sorted(k for k in local if k in remote and remote[k] != local[k])
    only_remote = sorted(k for k in remote if k not in local)
    print(f"import {env_file.name} → {env}{secret_path}: {len(new)} novas, {len(changed)} diferentes, "
          f"{len(local) - len(new) - len(changed)} iguais")
    if new:
        step(c.dry_run, "criar: " + ", ".join(new))
        c.call("POST", "/api/v4/secrets/batch", {"projectId": proj["id"], "environment": env, "secretPath": secret_path,
               "secrets": [{"secretKey": k, "secretValue": local[k]} for k in new]})
    if changed:
        # Não sobrescreve: o Infisical é a fonte de verdade depois do primeiro import.
        print("  [aviso] diferem do Infisical (mantido o valor do Infisical): " + ", ".join(changed))
    if only_remote:
        print("  [info]  só no Infisical: " + ", ".join(only_remote))


def cmd_apply(dry_run):
    cfg = tomllib.loads(CONFIG.read_text())
    c = Client(dry_run)
    print(f"Infisical {API} — org {c.org_id} — {'PLAN (nada alterado)' if dry_run else 'APPLY'}")
    for p in cfg.get("project", []):
        proj = ensure_project(c, p)
        if proj["id"] and "environments" not in proj:
            proj = c.call("GET", f"/api/v1/projects/slug/{p['slug']}")
        ensure_environments(c, proj, p)
        for rt in p.get("runtime", []):
            ensure_runtime_identity(c, proj, rt)
        for repo in p.get("repo", []):
            link_repo(c, proj, repo)


def cmd_audit(hours):
    c = Client(dry_run=True)
    start = (datetime.now(timezone.utc) - timedelta(hours=hours)).strftime("%Y-%m-%dT%H:%M:%S.000Z")
    q = urllib.parse.urlencode({"startDate": start, "limit": 1000})
    logs = c.call("GET", f"/api/v1/organization/audit-logs?{q}").get("auditLogs", [])
    print(f"audit log — últimas {hours}h — {len(logs)} eventos")
    by_actor = Counter()
    reads = Counter()
    for e in logs:
        meta = e.get("actorMetadata") or {}
        actor = f"{e.get('actor')}:{meta.get('name') or meta.get('email') or meta.get('username') or '?'}"
        ev = e.get("event", {}).get("type", e.get("eventType", "?"))
        by_actor[(actor, ev)] += 1
        if ev in ("get-secrets", "get-secret"):
            env = e.get("event", {}).get("metadata", {}).get("environment", "?")
            reads[(actor, env)] += 1
    for (actor, ev), n in sorted(by_actor.items(), key=lambda x: -x[1]):
        print(f"  {n:5d}  {actor:40s} {ev}")
    if reads:
        print("leitura de segredos por ator/ambiente:")
        for (actor, env), n in sorted(reads.items(), key=lambda x: -x[1]):
            print(f"  {n:5d}  {actor:40s} {env}")


if __name__ == "__main__":
    args = sys.argv[1:] or ["plan"]
    if args[0] == "plan":
        cmd_apply(dry_run=True)
    elif args[0] == "apply":
        cmd_apply(dry_run=False)
    elif args[0] == "audit":
        cmd_audit(int(args[1]) if len(args) > 1 else 24)
    else:
        print(__doc__)
        sys.exit(2)
