#!/usr/bin/env python3
"""Operação do Coolify central pela API (ADR 064, fase A), com a credencial do cofre (nunca na tela).

  cp-coolify [--client C] [--provider P] key
        garante a chave SSH "cp-servers" no Coolify e imprime a pública (vai no COOLIFY_PUBKEY do app-server.sh)
  cp-coolify ... server add <nome> <ip> [--proxy traefik|none] [--description TEXTO]
        cadastra a VPS como servidor remoto e espera ficar reachable/usable (Sentinel já sai com a URL da instância)
  cp-coolify ... servers
        lista servidores e estado
  cp-coolify ... service ensure <projeto> <ambiente> <servidor> <nome> <compose.yml>
        cria (se faltar) projeto, ambiente e service a partir do compose; as variáveis chegam pelo `cp-secrets sync`
        (ligado à rede do servidor: alcança os bancos gerenciados pelo nome = uuid)
  cp-coolify ... service compose <nome> <compose.yml>
        troca o compose de um service que já existe (vale no próximo restart). Em service -prod, tira DEMO_USER_PASSWORD
  cp-coolify ... service restart <nome> [--latest]
        reinicia e espera ficar running (--latest baixa a imagem antes: é o deploy de um service)
  cp-coolify ... db restart <nome>
        reinicia o banco e espera ficar running
  cp-coolify ... s3 ensure <nome> <endpoint> <bucket> [--region R]
        destino S3 dos backups; chave/segredo vêm de CP_S3_KEY/CP_S3_SECRET no ambiente (nunca argumento)
  cp-coolify ... db ensure <projeto> <ambiente> <servidor> <nome> <cli>/<proj>/<env> [--db healthstay]
        Postgres gerenciado; usuário/senha = POSTGRES_USER/POSTGRES_PASSWORD do cofre; grava DB_HOST (uuid) no cofre
  cp-coolify ... backup ensure <banco> <s3> [--frequency "0 3 * * *"] [--keep 14]
        backup agendado só para o S3 (retenção por quantidade)
  cp-coolify ... backup now <banco>
        dispara um backup e espera; imprime o caminho no S3
  cp-coolify ... db restore <banco> <s3> <caminho>
        restaura do S3 por cima (replace_existing) e espera terminar

Padrão: --client easygoal --provider coolify (ou CP_COOLIFY_PROVIDER). Idempotente por nome; imprime só nomes/uuids.
"""
import base64
import importlib.machinery
import json
import importlib.util
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
_loader = importlib.machinery.SourceFileLoader("cps", str(HERE / "cp-secrets"))
_spec = importlib.util.spec_from_loader("cps", _loader)
cps = importlib.util.module_from_spec(_spec)
_argv, sys.argv = sys.argv, ["cp-secrets"]
_loader.exec_module(cps)
sys.argv = _argv
from cp_providers import ProviderError, http  # noqa: E402

KEY_NAME = "cp-servers"


class Coolify:
    def __init__(self, client, provider):
        tok = cps.operator_token()
        d = cps.kv_read(tok, cps.kv_path(client, "_providers", provider))
        cps.call("POST", "auth/token/revoke-self", token=tok)
        if not d:
            cps.die(f"kv/{client}/_providers/{provider} vazio (cp-secrets provider set {client} {provider})")
        self.base = d["data"]["url"].rstrip("/") + "/api/v1"
        self.token = d["data"]["token"]

    def __call__(self, method, path, body=None):
        try:
            return http(method, self.base + path, self.token, body)
        except ProviderError as e:
            cps.die(str(e))

    def by_name(self, path, name):
        return next((i for i in self("GET", path) if i.get("name") == name), None)


def cmd_key(api):
    key = api.by_name("/security/keys", KEY_NAME)
    if not key:
        with tempfile.TemporaryDirectory() as d:
            subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "coolify-cp", "-f", f"{d}/k"], check=True)
            key = api("POST", "/security/keys", {"name": KEY_NAME, "description": "Coolify central → VPS de app",
                                                 "private_key": Path(f"{d}/k").read_text()})
        key = api("GET", f"/security/keys/{key['uuid']}")
        print(f"[ok] chave {KEY_NAME} criada ({key['uuid']}); a privada fica só no Coolify", file=sys.stderr)
    print(key["public_key"].strip())


def cmd_server_add(api, name, ip, proxy, description):
    key = api.by_name("/security/keys", KEY_NAME) or cps.die(f"sem chave {KEY_NAME}: rode cp-coolify key")
    srv = api.by_name("/servers", name)
    if not srv:
        srv = api("POST", "/servers", {"name": name, "description": description, "ip": ip, "port": 22, "user": "root",
                                       "private_key_uuid": key["uuid"], "proxy_type": proxy, "instant_validate": True})
        print(f"servidor {name}: criado {srv['uuid']} — validando (instala o que falta via SSH)")
    for _ in range(90):
        st = api("GET", f"/servers/{srv['uuid']}").get("settings") or {}
        if st.get("is_reachable") and st.get("is_usable"):
            print(f"[ok] servidor {name} {srv['uuid']}: reachable, usable")
            return
        time.sleep(5)
    cps.die(f"servidor {name} não ficou reachable/usable (ver Servers → {name} no painel)")


def cmd_servers(api):
    for s in api("GET", "/servers"):
        st = s.get("settings") or {}
        print(f"{s['name']:20s} {s['ip']:16s} {s['uuid']}  reachable={st.get('is_reachable')} usable={st.get('is_usable')}")


def cmd_service_ensure(api, project, env, server, name, compose):
    srv = api.by_name("/servers", server) or cps.die(f"servidor {server} não existe (cp-coolify server add)")
    proj = api.by_name("/projects", project) or api("POST", "/projects", {"name": project})
    if not next((e for e in api("GET", f"/projects/{proj['uuid']}/environments") if e["name"] == env), None):
        api("POST", f"/projects/{proj['uuid']}/environments", {"name": env})
    svc = api.by_name("/services", name)
    if not svc:
        raw = compose_for(name, compose)
        svc = api("POST", "/services", {"name": name, "project_uuid": proj["uuid"], "environment_name": env,
                                        "server_uuid": srv["uuid"], "docker_compose_raw": raw, "instant_deploy": False,
                                        "connect_to_docker_network": True})
        print(f"[ok] service {name} criado ({svc['uuid']}) em {project}/{env} @ {server} — variáveis: cp-secrets sync")
    else:
        print(f"[ok] service {name} já existe ({svc['uuid']})")


def compose_for(name, compose):
    """Em prod a API não aceita DEMO_USER_PASSWORD vazia: o compose de prod não pode declarar a variável."""
    text = Path(compose).read_text()
    if name.endswith("-prod"):
        text = "".join(line for line in text.splitlines(keepends=True) if not line.lstrip().startswith("DEMO_USER_PASSWORD:"))
    return base64.b64encode(text.encode()).decode()


def cmd_service_compose(api, name, compose):
    svc = api.by_name("/services", name) or cps.die(f"service {name} não existe (cp-coolify service ensure)")
    api("PATCH", f"/services/{svc['uuid']}", {"docker_compose_raw": compose_for(name, compose)})
    if name.endswith("-prod"):  # o Coolify guarda a variável à parte e continua a injetá-la mesmo fora do compose
        for env in api("GET", f"/services/{svc['uuid']}/envs"):
            if env.get("key") == "DEMO_USER_PASSWORD":
                api("DELETE", f"/services/{svc['uuid']}/envs/{env['uuid']}")
                print(f"[ok] {name}: DEMO_USER_PASSWORD removida das variáveis do service")
    print(f"[ok] compose de {name} atualizado; vale no próximo restart")


def cmd_restart(api, coll, name, latest=False):
    item = api.by_name(f"/{coll}", name) or cps.die(f"{name} não existe")
    suffix = "?latest=true" if latest else ""
    api("POST", f"/{coll}/{item['uuid']}/restart{suffix}")
    print(f"[ok] {name}: {'deploy' if latest else 'restart'} na fila")
    # O estado antigo pode continuar "running" por um instante: espera sair ou confirma depois de 20 s estável.
    time.sleep(20)
    def healthy():
        status = str(api("GET", f"/{coll}/{item['uuid']}").get("status", ""))
        return status.startswith("running") and not status.endswith("unhealthy")
    wait(healthy, f"{name} voltar ao ar (ver o log bruto no Coolify)", timeout=300)
    print(f"[ok] {name}: {api('GET', f'/{coll}/{item['uuid']}').get('status')}")


def wait(fn, what, timeout=600, every=5):
    deadline = time.time() + timeout
    while time.time() < deadline:
        r = fn()
        if r:
            return r
        time.sleep(every)
    cps.die(f"{what}: não terminou em {timeout}s")


def cmd_s3_ensure(api, name, endpoint, bucket, region):
    if api.by_name("/s3-storages", name):
        print(f"[ok] s3 {name} já existe")
        return
    key, secret = os.environ.get("CP_S3_KEY"), os.environ.get("CP_S3_SECRET")
    if not (key and secret):
        cps.die("defina CP_S3_KEY e CP_S3_SECRET no ambiente (ex.: cp-secrets provider exec ...)")
    st = api("POST", "/s3-storages", {"name": name, "endpoint": endpoint, "bucket": bucket, "region": region,
                                      "key": key, "secret": secret, "use_path_style_endpoint": True})
    print(f"[ok] s3 {name} criado ({st['uuid']}) → {endpoint}/{bucket}")


def cmd_db_ensure(api, project, env, server, name, kvpath, dbname):
    db = api.by_name("/databases", name)
    if not db:
        srv = api.by_name("/servers", server) or cps.die(f"servidor {server} não existe")
        proj = api.by_name("/projects", project) or api("POST", "/projects", {"name": project})
        if not next((e for e in api("GET", f"/projects/{proj['uuid']}/environments") if e["name"] == env), None):
            api("POST", f"/projects/{proj['uuid']}/environments", {"name": env})
        tok = cps.operator_token()
        data = (cps.kv_read(tok, kvpath) or {}).get("data") or cps.die(f"kv/{kvpath} vazio")
        cps.call("POST", "auth/token/revoke-self", token=tok)
        db = api("POST", "/databases/postgresql", {
            "name": name, "project_uuid": proj["uuid"], "environment_name": env, "server_uuid": srv["uuid"],
            "image": "postgres:16-alpine", "postgres_user": data["POSTGRES_USER"],
            "postgres_password": data["POSTGRES_PASSWORD"], "postgres_db": dbname, "instant_deploy": True})
        print(f"[ok] postgres {name} criado ({db['uuid']}) em {project}/{env} @ {server}")
    st = str(api("GET", f"/databases/{db['uuid']}").get("status", ""))
    if not st.startswith(("running", "starting")):
        api("POST", f"/databases/{db['uuid']}/start")  # parado (ex.: start anterior falhou): pede de novo
    wait(lambda: str(api("GET", f"/databases/{db['uuid']}").get("status", "")).startswith("running"),
         f"postgres {name} subir (ver Logs do banco no painel)", timeout=300)
    # O app alcança o banco pelo nome do container (= uuid) na rede do servidor.
    tok = cps.operator_token()
    cur = (cps.kv_read(tok, kvpath) or {}).get("data") or {}
    if cur.get("DB_HOST") != db["uuid"]:
        cps.call("POST", f"kv/data/{kvpath}", {"data": {**cur, "DB_HOST": db["uuid"]}}, token=tok)
        print(f"[ok] kv/{kvpath}: DB_HOST → {db['uuid']} (propagar: cp-secrets sync)")
    cps.call("POST", "auth/token/revoke-self", token=tok)
    print(f"[ok] postgres {name} running")


def _db(api, name):
    return api.by_name("/databases", name) or cps.die(f"banco {name} não existe (cp-coolify db ensure)")


def cmd_backup_ensure(api, dbname, s3name, frequency, keep):
    db = _db(api, dbname)
    s3 = api.by_name("/s3-storages", s3name) or cps.die(f"s3 {s3name} não existe")
    if api("GET", f"/databases/{db['uuid']}/backups"):
        print(f"[ok] backup de {dbname} já agendado")
        return
    b = api("POST", f"/databases/{db['uuid']}/backups", {
        "frequency": frequency, "enabled": True, "save_s3": True, "s3_storage_uuid": s3["uuid"],
        "disable_local_backup": True, "database_backup_retention_amount_s3": keep})
    print(f"[ok] backup de {dbname} agendado ({frequency}, mantém {keep} no S3) {b.get('uuid', '')}")


def cmd_backup_now(api, dbname):
    db = _db(api, dbname)
    sched = (api("GET", f"/databases/{db['uuid']}/backups") or cps.die(f"{dbname} sem backup agendado"))[0]
    before = {e["uuid"] for e in api("GET", f"/databases/{db['uuid']}/backups/{sched['uuid']}/executions").get("executions", [])}
    api("PATCH", f"/databases/{db['uuid']}/backups/{sched['uuid']}", {"backup_now": True})

    def done():
        ex = [e for e in api("GET", f"/databases/{db['uuid']}/backups/{sched['uuid']}/executions").get("executions", [])
              if e["uuid"] not in before]
        if ex and ex[0]["status"] in ("success", "failed"):
            return ex[0]
    ex = wait(done, f"backup de {dbname}")
    if ex["status"] != "success" or not ex.get("s3_uploaded", True):
        cps.die(f"backup de {dbname}: {ex['status']} — {str(ex.get('message', ''))[:200]}")
    print(ex["filename"])


def cmd_db_restore(api, dbname, s3name, path):
    db = _db(api, dbname)
    s3 = api.by_name("/s3-storages", s3name) or cps.die(f"s3 {s3name} não existe")
    imp = api("POST", f"/databases/{db['uuid']}/imports",
              {"source": "s3", "s3_storage_uuid": s3["uuid"], "path": path, "replace_existing": True})
    aid = imp["id"]

    def done():
        st = api("GET", f"/databases/{db['uuid']}/imports/{aid}")
        if st.get("status") in ("finished", "error", "killed", "cancelled", "closed"):
            return st
    st = wait(done, f"restauração de {dbname}")
    if st["status"] != "finished" or st.get("exit_code") not in (0, None):
        cps.die(f"restauração de {dbname}: {st['status']} (exit {st.get('exit_code')})")
    print(f"[ok] {dbname} restaurado de {path}")


def main(args):
    client = os.environ.get("CP_CLIENT", "easygoal")
    provider = os.environ.get("CP_COOLIFY_PROVIDER", "coolify")
    opts = {}
    rest = []
    it = iter(args)
    for a in it:
        if a in ("--client", "--provider", "--proxy", "--description", "--region", "--db", "--frequency", "--keep"):
            opts[a[2:]] = next(it, "")
        else:
            rest.append(a)
    client, provider = opts.get("client", client), opts.get("provider", provider)
    if not rest:
        print(__doc__)
        sys.exit(2)
    api = Coolify(client, provider)
    if rest == ["key"]:
        cmd_key(api)
    elif rest[:2] == ["server", "add"] and len(rest) == 4:
        cmd_server_add(api, rest[2], rest[3], opts.get("proxy", "traefik"), opts.get("description", ""))
    elif rest == ["servers"]:
        cmd_servers(api)
    elif rest[:2] == ["service", "ensure"] and len(rest) == 7:
        cmd_service_ensure(api, *rest[2:])
    elif rest[:2] == ["service", "compose"] and len(rest) == 4:
        cmd_service_compose(api, rest[2], rest[3])
    elif rest[:2] == ["service", "restart"] and len(rest) in (3, 4) and rest[3:] in ([], ["--latest"]):
        cmd_restart(api, "services", rest[2], latest=rest[3:] == ["--latest"])
    elif rest[:2] == ["db", "restart"] and len(rest) == 3:
        cmd_restart(api, "databases", rest[2])
    elif rest[:2] == ["s3", "ensure"] and len(rest) == 5:
        cmd_s3_ensure(api, *rest[2:], opts.get("region", "us-east-1"))
    elif rest[:2] == ["db", "ensure"] and len(rest) == 7:
        cmd_db_ensure(api, *rest[2:], opts.get("db", "healthstay"))
    elif rest[:2] == ["backup", "ensure"] and len(rest) == 4:
        cmd_backup_ensure(api, rest[2], rest[3], opts.get("frequency", "0 3 * * *"), int(opts.get("keep", 14)))
    elif rest[:2] == ["backup", "now"] and len(rest) == 3:
        cmd_backup_now(api, rest[2])
    elif rest[:2] == ["db", "restore"] and len(rest) == 5:
        cmd_db_restore(api, *rest[2:])
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
