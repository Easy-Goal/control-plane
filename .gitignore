# Segredos de bootstrap do control plane — nunca commitar. Backup offline obrigatório (ver README).
.env
**/.env
!**/.env.example
# Credenciais de identidades (bootstrap e runtime) — geradas, nunca versionar
.bootstrap.env
**/.bootstrap.env
# OpenBao: chaves de unseal/token root (mover para o gerenciador de senhas) e credenciais de runtime
openbao/.init.json
openbao/runtime/
openbao/backups/
# Export do offboard (texto puro): importar no Bitwarden do cliente e apagar com shred -u
openbao/exports/
__pycache__/
.venv/
# Chaves privadas baixadas (GitHub App etc.): ir para o cofre e shred -u
*.pem
*.key
# CA do cofre do control plane por ambiente (pública; regenerada pelo install)
openbao/tls/
# Chaves do S3 do laboratório (geradas por sim/lab.sh)
sim/.s3.json
# Stack local: cópia do compose e .env com as senhas de admin (gerados por scripts/cp-local)
local/observability/
panel/state/
dist/
machine.toml
workspace.toml
